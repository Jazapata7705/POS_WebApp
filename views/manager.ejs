
<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>Manage Menu</title>
    <link rel="stylesheet" href="/css/style.css">
    <style>
        .low-stock-warning {
            background: #fff3cd;
            border: 1px solid #ffe08a;
            border-left: 5px solid #e0a800;
            border-radius: 8px;
            padding: 1rem 1.25rem;
            margin: 1.25rem 0;
        }

        .low-stock-warning h2 {
            margin-top: 0;
            color: #856404;
        }

        .low-stock-warning ul {
            margin-bottom: 0;
            padding-left: 1.25rem;
        }

        .low-stock-warning li {
            margin: 0.4rem 0;
            color: #664d03;
        }

        .stock-count {
            font-weight: 700;
        }

        .stock-ok {
            color: #198754;
            font-size: 0.85rem;
            font-weight: 600;
        }
    </style>
</head>
<body>
    <% if (!managerUnlocked) { %>
    <%- include('partials/staff-login', { label: 'Manager', action: '/manager/login', button: 'Unlock dashboard', loginError }) %>
    <% } else { %>
    <%
        const categories = [...new Set(items.map(item => item.category || 'Uncategorized'))];

        const lowStockItems = items.filter(item =>
            Number(item.quantity_in_stock) <= Number(item.low_stock_threshold)
        );
    %>
    <header class="navbar">
        <a class="logo" href="/" aria-label="Return to menu">Menu</a>
        <nav class="nav-links" aria-label="Main">
            <a class="nav-link" href="/orders">Orders</a>
            <a class="nav-link" href="/manager" aria-current="page">Manager</a>
            <a class="nav-link" href="/manager/sales">Sales report</a>
            <a href="/checkout" class="checkout-btn">Checkout</a>
        </nav>
    </header>

    <main class="checkout-page">
        <section class="checkout-card" aria-labelledby="manager-heading">
            <a class="back-to-menu" href="/">← Back to menu</a>
            <p class="eyebrow">Manager view</p>
            <h1 id="manager-heading">Manage menu</h1>
            <form method="post" action="/manager/logout">
                <button type="submit">Lock manager access</button>
            </form>

            <p class="manager-hint">Change a drink's price or mark it sold out. Sold-out drinks stay on the menu but can't be ordered.</p>

            <!-- Low Stock Warning Section -->
            <% if (lowStockItems.length > 0) { %>
                <div class="low-stock-warning" role="alert">
                    <h2>⚠ Low Inventory Warning</h2>
                    <p>The following items are at or below their low-stock threshold:</p>
                    <ul>
                        <% lowStockItems.forEach(function(item) { %>
                            <li>
                                <strong><%= item.name %></strong>:
                                <span class="stock-count"><%= item.quantity_in_stock %></span>
                                remaining
                                (Low-stock threshold: <%= item.low_stock_threshold %>)
                            </li>
                        <% }); %>
                    </ul>
                </div>
            <% } else { %>
                <p class="stock-ok">✓ All menu items are above their low-stock thresholds.</p>
            <% } %>
            <!-- End Low Stock Warning Section -->

            <h2 class="manager-category">Add New Drink</h2>
            <!-- Add New Drink Form -->
            <form class="manager-form" method="post" action="/manager/items/add">

                <label class="manager-name">
                    <input
                        name="name"
                        type="text"
                        placeholder="Drink name"
                        required
                    >
                </label>

                <label class="manager-price">
                    <span>Price $</span>
                    <input
                        name="price"
                        type="number"
                        min="0"
                        max="100"
                        step="0.01"
                        required
                    >
                </label>

                <label class="manager-available">
                    <input
                        name="is_available"
                        type="checkbox"
                        checked
                    >
                    <span>Available</span>
                </label>

                <label>
                    <span>Category</span>
                    <select name="category" required>
                        <% categories.forEach(function(cat) { %>
                            <option value="<%= cat %>"><%= cat %></option>
                        <% }); %>
                    </select>
                </label>

                <button class="manager-save" type="submit">
                    Add Drink
                </button>

            </form>
            <!-- End of Add New Drink Form -->

            <% categories.forEach(function(cat) { %>
                <h2 class="manager-category"><%= cat %></h2>
                <ul class="manager-list">
                    <% items.filter(item => (item.category || 'Uncategorized') === cat).forEach(function(item) {
                        const id = item.menu_item_id;
                    %>
                        <li id="item-<%= id %>" class="manager-row">
                            <form class="manager-form" method="post" action="/manager/items/<%= id %>">
                                <span class="manager-name"><%= item.name %></span>

                                <label class="manager-price">
                                    <span>Price $</span>
                                    <input name="price" type="number" min="0" max="100" step="0.01" required
                                           value="<%= Number(item.current_price).toFixed(2) %>" aria-label="Price for <%= item.name %>">
                                </label>

                                <label class="manager-available">
                                    <input name="is_available" type="checkbox"<%= Number(item.is_available) === 1 ? ' checked' : '' %>>
                                    <span>Available</span>
                                </label>

                                <button class="manager-save" type="submit">Save</button>

                                <% if (savedId === id) { %>
                                    <span class="manager-status" role="status">Saved</span>
                                <% } else if (errorId === id) { %>
                                    <span class="manager-status manager-status-error" role="alert">Enter a price from 0 to 100</span>
                                <% } %>
                            </form>
                        </li>
                    <% }); %>
                </ul>
            <% }); %>
        </section>
    </main>
    <% } %>
</body>
</html>
