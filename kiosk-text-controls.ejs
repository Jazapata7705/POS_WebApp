<div class="kiosk-text-controls" role="group" aria-label="Accessibility settings" hidden>
    <span>Text size</span>
    <button type="button" data-text-change="-1" aria-label="Decrease text size">A−</button>
    <output aria-label="Current text size">100%</output>
    <button type="button" data-text-change="1" aria-label="Increase text size">A+</button>
    <button type="button" id="kiosk-high-contrast">High contrast</button>
</div>